# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/lhsec.db

# ── CT Log sources ────────────────────────────────────────────────────────────
# Leave CERTSPOTTER_API_KEY empty to use only crt.sh (free, no key needed)
CERTSPOTTER_API_KEY=

# ── Nuclei ────────────────────────────────────────────────────────────────────
# Path to nuclei binary (default: assumes nuclei is in $PATH)
NUCLEI_BINARY=nuclei
# Default severity filter: comma-separated list
NUCLEI_DEFAULT_SEVERITY=critical,high
# Path where nuclei result files are stored (relative to backend/)
NUCLEI_RESULTS_DIR=../data/nuclei_results

# ── App ───────────────────────────────────────────────────────────────────────
APP_DEBUG=true
