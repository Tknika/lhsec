# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/lhsec.db

# ── CT Log sources ────────────────────────────────────────────────────────────
# Leave CERTSPOTTER_API_KEY empty to use only crt.sh (free, no key needed)
CERTSPOTTER_API_KEY=

# ── Nuclei ────────────────────────────────────────────────────────────────────
# Path to nuclei binary (default: assumes nuclei is in $PATH)
NUCLEI_BINARY=nuclei
# Default severity filter: comma-separated list
NUCLEI_DEFAULT_SEVERITY=critical,high
# Path where nuclei result files are stored (relative to backend/)
NUCLEI_RESULTS_DIR=../data/nuclei_results
# WAF block detection: abort scan when error rate exceeds this threshold (0-1).
# 0.70 = 70% global error rate — generous, avoids false-positives from dead hosts.
# Set to 1.0 to disable auto-abort entirely.
NUCLEI_WAF_ERROR_RATE_THRESHOLD=0.70
# Minimum requests before checking error rate (prevents early false aborts)
NUCLEI_WAF_MIN_REQUESTS=200
# Per-host max errors before nuclei drops the host (-mhe flag)
NUCLEI_MAX_HOST_ERROR=100

# ── App ───────────────────────────────────────────────────────────────────────
APP_DEBUG=true
